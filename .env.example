# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.
# 값이 비어 있으면 해당 기능은 "설정 필요" 상태로 비활성화됩니다(가짜 성공 금지).

# --- 앱 ---
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/shorts_studio.sqlite3

# --- 프로바이더 선택 (free | api) ---
LLM_PROVIDER=free
TTS_PROVIDER=free

# --- LLM API (선택: LLM_PROVIDER=api 일 때만 필요) ---
# OPENAI_API_KEY=
# LLM_MODEL=

# --- TTS API (선택) ---
# TTS_API_KEY=
# TTS_VOICE=

# --- 트렌드 분석 (선택: YouTube Data API v3) ---
# YOUTUBE_API_KEY=

# --- 무료 스톡 배경 (선택: Pexels, 상업 이용 무료) ---
# 무료 키 발급: https://www.pexels.com/api/
# PEXELS_API_KEY=

# --- 업로드 (선택: 권한 없으면 수동 패키지만 생성) ---
# YOUTUBE_OAUTH_CLIENT_SECRET_FILE=
