# Copy this file to .env and fill in values to enable optional providers.
# The offline defaults (tone TTS + gradient background) need NONE of these.

# ---- Provider selection (offline-safe defaults) ----
TTS_PROVIDER=tone
BG_PROVIDER=gradient

# ---- Optional network TTS (edge-tts) ----
# Requires outbound network to Microsoft. Only used when TTS_PROVIDER=edge.
EDGE_TTS_VOICE=en-US-AriaNeural

# ---- Optional background / image providers ----
# All require outbound network. Leave blank to stay fully offline.
#
# PEXELS_API_KEY: royalty-free stock footage for the knowledge-card background.
PEXELS_API_KEY=
#
# OPENAI_API_KEY: optional character-image generation for the micro-drama episode mode
# (draws real "well-drawn manga" character art instead of the offline code-drawn figure).
# You do NOT need this to render an episode: the offline default draws figures with no key,
# and you can instead drop your own art at assets/characters/<episode>/<character_id>.png.
# There is no IMAGE_PROVIDER or CHARACTER_ASSETS_DIR env var; the asset path is a fixed
# convention, not configurable via env.
OPENAI_API_KEY=

# ---- Future upload phase (YouTube Data API) ----
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
